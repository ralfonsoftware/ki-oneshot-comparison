            "value": "Die Datei ist größer als 250 MB."
          }
        }
      }
    },
    "The minimum term is not an end date. The tariff applies until the next tariff starts.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Mindestlaufzeit ist kein Enddatum. Der Tarif gilt, bis der nächste Tarif beginnt."
          }
        }
      }
    },
    "The original value stays visible in the reading's history.": {
      "localizations": {
