          "stringUnit": {
            "state": "translated",
            "value": "Der ursprüngliche Wert bleibt im Verlauf des Zählerstands sichtbar."
          }
        }
      }
    },
    "The price per kWh must be greater than 0.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Arbeitspreis muss größer als 0 sein."
          }
